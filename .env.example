# Cloudinary Public Config
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key

# Cloudinary Server Secrets (Node.js runtime only)
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase Data Plane (PostGIS + pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# External AI Reasoning (Claude Opus 5.5)
ANTHROPIC_API_KEY=your_anthropic_api_key

# App URL (For Webhooks and Verify QR links) - must be publicly reachable for Cloudinary webhooks
APP_BASE_URL=http://localhost:3000
