# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# NEXT_PUBLIC_* values are bundled into browser JavaScript: only put public values there.
# Everything else is server-only and must never be exposed to the client.

# --- Browser-safe -----------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key
# Supabase: Project Settings > API. The anon key is safe in the browser only because every table
# has RLS enabled with no anon policies (it can read nothing today).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Server-only secrets (Node.js runtime; never prefix with NEXT_PUBLIC_) ---
# The service-role key bypasses RLS. lib/db.ts uses it for all data access.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Gemini: agent investigations, search planning, story synthesis and embeddings. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional overrides: GEMINI_MODEL=gemini-2.5-flash  GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional: AGENT_MAX_ANALYZE=40  AGENT_AUTO_TRIGGER_THRESHOLD=10

# --- Server config ------------------------------------------------------------
# Used for webhooks and verify QR links; must be publicly reachable for Cloudinary webhooks.
APP_BASE_URL=http://localhost:3000
